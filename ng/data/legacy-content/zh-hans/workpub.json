          },
          "dialogue0": {
            "id": "dialogue0",
            "type": "text",
            "inputs": {
              "displayTo": "his-app",
              "speaker": "患者",
              "text": "医生，药吃了好几天，症状一点都没减轻，你们到底有没有认真看病？"
            },
            "outputs": {},
            "x": 100,
            "y": 100
          },
          "dialogue1": {
            "id": "dialogue1",
            "type": "text",
            "inputs": {
              "displayTo": "his-app",
              "speaker": "患者",
              "text": "我照着处方按时吃药，病情却越来越严重，这让我怎么相信你们？"
            },
            "outputs": {},
            "x": 100,
            "y": 100
          },
          "dialogue2": {
            "id": "dialogue2",
            "type": "text",
            "inputs": {
              "displayTo": "his-app",
              "speaker": "患者",
              "text": "这药不仅没效果，还让我整晚睡不着，你们必须给我一个解释。"
            },
            "outputs": {},
            "x": 100,
            "y": 100
          },
          "explain": {
            "id": "explain",
            "type": "choice",
            "inputs": {
              "branchCount": 1,
              "label0": "向愤怒的患者解释"
            },
            "outputs": {},
            "x": 100,
            "y": 100
          },
          "skill": {
            "id": "skill",
