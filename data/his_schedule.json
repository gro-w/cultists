{
  "schedule": [
    {
      "day": 1,
      "phase": "day",
      "note": "第一天白天：门诊照常，两位病人依次就诊。",
      "patients": [
        {
          "id": "patient_wangfang_d1",
          "name": "王芳",
          "age": 34,
          "recordTemplateId": "record_fever",
          "keywords": [
            {
              "id": "fever",
              "label": "发热",
              "category": "symptom",
              "definition": "体温超过37.3摄氏度的状态，是感染或炎症的常见信号。"
            },
            {
              "id": "cough",
              "label": "咳嗽",
              "category": "symptom",
              "definition": "呼吸道受到刺激时产生的反射性动作，可提示上呼吸道感染。"
            },
            {
              "id": "insomnia",
              "label": "失眠",
              "category": "symptom",
              "definition": "难以入睡或睡眠质量差的状态，可能与压力或病痛有关。"
            }
          ],
          "dialogueTree": {
            "start": "greet",
            "nodes": {
              "greet": {
                "speaker": "npc",
                "text": "医生，我这两天一直[[fever]]，量了体温有38.5度。",
                "options": [
                  { "label": "还有其他不舒服的地方吗？", "next": "ask_more" },
                  { "label": "我先检查一下再说。", "next": "check_direct" }
                ]
              },
              "ask_more": {
                "speaker": "npc",
                "text": "嗯，还伴有[[cough]]，晚上也因为难受[[insomnia]]。",
                "options": [{ "label": "好的，我先给你做个记录。", "next": "end" }]
              },
              "check_direct": {
                "speaker": "npc",
                "text": "麻烦您了，医生。",
                "options": [{ "label": "好的，我先给你做个记录。", "next": "end" }]
              },
              "end": {
                "speaker": "npc",
                "text": "谢谢医生，辛苦了。",
                "options": []
              }
            }
          }
        },
        {
          "id": "patient_lidong_d1",
          "name": "李东",
          "age": 52,
          "recordTemplateId": "record_headache",
          "keywords": [
            {
              "id": "headache",
              "label": "头痛",
              "category": "symptom",
              "definition": "头部区域的疼痛感，可由多种原因引起，包括疲劳、压力或疾病。"
            },
            {
              "id": "dizziness",
              "label": "眩晕",
              "category": "symptom",
              "definition": "感觉自身或周围环境在旋转、摇晃的症状。"
            },
            {
              "id": "mystery_note",
              "label": "神秘纸条",
              "category": "clue",
              "definition": "李东随口提到的一张纸条，内容不明，似乎与医院的传闻有关。"
            }
          ],
          "dialogueTree": {
            "start": "greet",
            "nodes": {
              "greet": {
                "speaker": "npc",
                "text": "大夫，我最近老是[[headache]]，站起来的时候还[[dizziness]]。",
                "options": [
                  { "label": "有没有摔倒或者受过伤？", "next": "ask_injury" },
                  { "label": "最近压力大吗？", "next": "ask_stress" }
                ]
              },
              "ask_injury": {
                "speaker": "npc",
                "text": "没有，倒是捡到一张[[mystery_note]]，你要看看吗？",
                "options": [
                  { "label": "好，给我看看。", "next": "end" },
                  { "label": "暂时不用了。", "next": "end_refuse" }
                ]
              },
              "ask_stress": {
                "speaker": "npc",
                "text": "确实，最近工作比较累，可能没休息好。",
                "options": [{ "label": "注意休息，别太累了。", "next": "end" }]
              },
              "end": {
                "speaker": "npc",
                "text": "谢谢大夫，我会注意的。",
                "options": []
              },
              "end_refuse": {
                "speaker": "npc",
                "text": "好的，那算了，医生您先忙。",
                "options": []
              }
            }
          }
        }
      ]
    },
    {
      "day": 1,
      "phase": "night",
      "note": "第一天晚上：门诊已经下班，没有病人。",
      "patients": []
    },
