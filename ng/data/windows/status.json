{
  "id": "status",
  "title": "状态与属性",
  "icon": "📊",
  "width": 400,
  "height": 440,
  "resizable": true,
  "singleInstance": true,
  "valueGraph": {
    "nodes": {
      "san": {"id":"san","type":"getPublicVariable","inputs":{"id":1}},
      "money": {"id":"money","type":"getPublicVariable","inputs":{"id":2}},
      "energy": {"id":"energy","type":"getVariable","inputs":{"key":"gameState:energy"}},
      "physical": {"id":"physical","type":"getVariable","inputs":{"key":"gameState:physical"}},
      "satiety": {"id":"satiety","type":"getVariable","inputs":{"key":"gameState:satiety"}},
      "sanText": {"id":"sanText","type":"arithmetic","inputs":{"operator":"concat","left":"理智（SAN）：","right":{"nodeId":"san","port":"value"}}},
      "moneyText": {"id":"moneyText","type":"arithmetic","inputs":{"operator":"concat","left":"金钱：","right":{"nodeId":"money","port":"value"}}},
      "energyText": {"id":"energyText","type":"arithmetic","inputs":{"operator":"concat","left":"精力：","right":{"nodeId":"energy","port":"value"}}},
      "physicalText": {"id":"physicalText","type":"arithmetic","inputs":{"operator":"concat","left":"体力：","right":{"nodeId":"physical","port":"value"}}},
      "satietyText": {"id":"satietyText","type":"arithmetic","inputs":{"operator":"concat","left":"饱腹度：","right":{"nodeId":"satiety","port":"value"}}}
    }
  },
  "root": {
    "widgetId": "status-root",
    "className": "app-status",
    "type": "container",
    "flow": "vertical",
    "gap": 8,
    "padding": 10,
    "children": [
      {"widgetId":"status-title","type":"label","className":"status-heading","text":"角色状态"},
      {"widgetId":"status-san","type":"label","className":"status-row","text":{"nodeId":"sanText","port":"value"}},
      {"widgetId":"status-money","type":"label","className":"status-row","text":{"nodeId":"moneyText","port":"value"}},
      {"widgetId":"status-energy","type":"label","className":"status-row","text":{"nodeId":"energyText","port":"value"}},
      {"widgetId":"status-energy-bar","type":"progress","className":"status-bar bevel-in","value":{"nodeId":"energy","port":"value"},"max":100},
      {"widgetId":"status-physical","type":"label","className":"status-row","text":{"nodeId":"physicalText","port":"value"}},
      {"widgetId":"status-physical-bar","type":"progress","className":"status-bar bevel-in","value":{"nodeId":"physical","port":"value"},"max":100},
      {"widgetId":"status-satiety","type":"label","className":"status-row","text":{"nodeId":"satietyText","port":"value"}},
      {"widgetId":"status-satiety-bar","type":"progress","className":"status-bar bevel-in","value":{"nodeId":"satiety","port":"value"},"max":100},
      {"widgetId":"status-note","type":"label","className":"status-note","text":"数值由当前游戏状态实时维护"}
    ]
  }
}
