        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "阿杰",
          "text": "喂喂喂，你这靠谱吗？",
          "continueKey": "dlg:line_010:continue"
        },
        "x": 3040,
        "y": 40
      },
      "line_011": {
        "id": "line_011",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "player",
          "text": "放心吧，包在我身上。",
          "continueKey": "dlg:line_011:continue"
        },
        "x": 3340,
        "y": 40
      },
      "line_012": {
        "id": "line_012",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "阿杰",
          "text": "如果他们知道我是……可能反而不会求着我女装了。",
          "continueKey": "dlg:line_012:continue"
        },
        "x": 3640,
        "y": 40
      },
      "line_013": {
        "id": "line_013",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "player",
          "text": "嗯，那你说，为啥up主都要拍女装福利视频呢？或者说，女装为什么可以作为福利呢？",
          "continueKey": "dlg:line_013:continue"
