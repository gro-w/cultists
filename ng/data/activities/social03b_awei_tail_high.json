      },
      "n11": {
        "id": "n11",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿伟",
          "text": "你知道阿杰的，从来不会借钱给别人。至于彬彬……",
          "continueKey": "dlg:n11:continue"
        }
      },
      "n12": {
        "id": "n12",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "player",
          "text": "怎么了？",
          "continueKey": "dlg:n12:continue"
        }
      },
      "n13": {
        "id": "n13",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿伟",
          "text": "说不好，或许是我的错觉。",
          "continueKey": "dlg:n13:continue"
        }
      },
      "n14": {
        "id": "n14",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
