      },
      "line_053": {
        "id": "line_053",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "克苏鲁",
          "text": "死亡的门曾向你显露吗？死荫的门你曾见过吗？",
          "continueKey": "dlg:line_053:continue"
        }
      },
      "line_054": {
        "id": "line_054",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "克苏鲁",
          "text": "地的广大你能明透吗？你若全知道，只管说吧。",
          "continueKey": "dlg:line_054:continue"
        }
      },
      "line_055": {
        "id": "line_055",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "克苏鲁",
          "text": "光明的居所从何而至？黑暗的本位在于何处？",
          "continueKey": "dlg:line_055:continue"
        }
      },
      "line_056": {
        "id": "line_056",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "克苏鲁",
          "text": "你能带到本境，能看明其室之路吗？",
          "continueKey": "dlg:line_056:continue"
        }
      },
      "line_057": {
        "id": "line_057",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "克苏鲁",
          "text": "你能系住昴星的结吗？能解开参星的带吗？",
