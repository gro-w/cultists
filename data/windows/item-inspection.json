{
  "id": "item-inspection",
  "title": "调查铺位",
  "icon": "🔎",
  "width": 520,
  "height": 420,
  "resizable": true,
  "singleInstance": true,
  "valueGraph": {
    "nodes": {
      "items": {
        "id": "items",
        "type": "getRuntimeCollection",
        "inputs": {
          "collectionId": "dormDeskItems"
        }
      },
      "active": {
        "id": "active",
        "type": "getRuntimeRecord",
        "inputs": {
          "collectionId": "dormDeskItems",
          "recordId": {
            "variable": "item:activeId"
          }
        }
      },
      "activeName": {
        "id": "activeName",
        "type": "getProperty",
        "inputs": {
          "value": {
            "nodeId": "active",
            "port": "value"
          },
          "key": "name"
        }
      },
      "activeDescription": {
        "id": "activeDescription",
        "type": "getProperty",
        "inputs": {
          "value": {
            "nodeId": "active",
            "port": "value"
          },
          "key": "description"
        }
      },
      "activeVariants": {
        "id": "activeVariants",
        "type": "getProperty",
        "inputs": {
          "value": {
            "nodeId": "active",
            "port": "value"
          },
          "key": "sanVariants"
        }
      },
      "activeVariant": {
        "id": "activeVariant",
        "type": "getProperty",
        "inputs": {
          "value": {
            "nodeId": "activeVariants",
            "port": "value"
          },
          "key": "70-90"
        }
      },
      "activeImage": {
        "id": "activeImage",
        "type": "getProperty",
        "inputs": {
          "value": {
            "nodeId": "activeVariant",
            "port": "value"
          },
          "key": "image"
        }
      }
    }
  },
  "root": {
    "widgetId": "item-inspection-root",
    "type": "container",
    "flow": "vertical",
    "gap": 8,
    "padding": 10,
    "className": "app-item-inspection",
    "children": [
      {
        "widgetId": "item-inspection-title",
        "type": "label",
        "text": "调查室友铺位上的物品"
      },
      {
        "widgetId": "item-inspection-hint",
        "type": "label",
        "text": "点击物品查看其调查信息。"
      },
      {
        "widgetId": "item-inspection-active-name",
        "type": "label",
        "text": {
          "nodeId": "activeName",
          "port": "value"
        },
        "className": "item-inspection-active-name"
      },
      {
        "widgetId": "item-inspection-active-image",
        "type": "image",
        "src": {
          "nodeId": "activeImage",
          "port": "value"
        },
        "alt": "物品图片",
        "className": "item-inspection-active-image"
      },
      {
        "widgetId": "item-inspection-active-description",
        "type": "label",
        "text": {
          "nodeId": "activeDescription",
          "port": "value"
        },
        "className": "item-inspection-active-description"
      },
      {
        "widgetId": "item-inspection-list",
        "type": "list",
        "className": "item-inspection-list panel-inset",
        "items": {
          "nodeId": "items",
          "port": "value"
        },
        "itemLabelField": "name",
        "itemMetaTemplate": "{{description}}",
        "itemClassName": "item-inspection-entry",
        "events": {
          "onItemClick": {
            "cl2": "/** CL2 export for activity data/windows/item-inspection.json.root.children[5].events.onItemClick Generated from canonical blueprint JSON. */ start: flowStart(); emit: emitEvent(\"item:inspect\", {\"itemId\":{\"variable\":\"event:value\"}}); end: end();"
          }
        }
      },
      {
        "widgetId": "item-inspection-close",
        "type": "button",
        "text": "关闭",
        "className": "win95-btn bevel-out",
        "events": {
          "onClick": {
            "cl2": "/** CL2 export for activity data/windows/item-inspection.json.root.children[6].events.onClick Generated from canonical blueprint JSON. */ start: flowStart(); close: closeWindow(\"item-inspection\"); end: end();"
          }
        }
      }
    ]
  }
}
