      "line_058": {
        "id": "line_058",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "克苏鲁",
          "text": "你能按时领出十二宫吗？能引导北斗和随它的众星吗？",
          "continueKey": "dlg:line_058:continue"
        }
      },
      "line_059": {
        "id": "line_059",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "克苏鲁",
          "text": "你知道天的定例吗？能使地归在天的权下吗？",
          "continueKey": "dlg:line_059:continue"
