        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "阿杰",
          "text": "不知道啊，别人都拍，我也跟着拍了。我的高赞评论里还有嬷嬷呢。",
          "continueKey": "dlg:line_014:continue"
        },
        "x": 4240,
        "y": 40
