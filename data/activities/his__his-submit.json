{
  "id": "his__his-submit",
  "type": "hisCustom",
  "displayName": "his-submit",
  "blueprint": {
    "startNodeId": "start",
    "nodes": {
      "start": {
        "id": "start",
        "type": "flowStart",
        "inputs": {}
      },
      "submit": {
        "id": "submit",
        "type": "emitEvent",
        "inputs": {
          "eventName": "content:hisSubmit",
          "payload": {
            "case": {
              "variable": "his:lastCase"
            },
            "resultMessage": {
              "variable": "his:resultMessage"
            },
            "patientId": {
              "nodeId": "patientId",
              "port": "value"
            }
          }
        }
      },
      "patientId": {
        "id": "patientId",
        "type": "getProperty",
        "inputs": {
          "value": {
            "variable": "his:selectedPatient"
          },
          "key": "id"
        }
      },
      "__prerequisite__": {
        "id": "__prerequisite__",
        "type": "prerequisite",
        "inputs": {
          "condition": true
        }
      },
      "__activity_expiry__": {
        "id": "__activity_expiry__",
        "type": "activityExpiry",
        "inputs": {
          "expires": false,
          "expiresAt": 0
        }
      },
      "time": {
        "id": "time",
        "type": "framework:consumeTime",
        "inputs": {
          "minutes": 20
        }
      },
      "end": {
        "id": "end",
        "type": "activityEnd",
        "inputs": {}
      }
    },
    "connections": [
      {
        "fromNodeId": "start",
        "fromPort": "flowOut",
        "toNodeId": "submit",
        "toPort": "flowIn"
      },
      {
        "fromNodeId": "submit",
        "fromPort": "flowOut",
        "toNodeId": "time",
        "toPort": "flowIn"
      },
      {
        "fromNodeId": "time",
        "fromPort": "flowOut",
        "toNodeId": "end",
        "toPort": "flowIn"
      }
    ]
  }
}
