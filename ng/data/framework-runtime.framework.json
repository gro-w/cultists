{
  "id": "framework-runtime",
  "collections": {
    "achievements": {
      "databaseId": "achievements"
    },
    "achievementStates": {
      "databaseId": "achievements",
      "mergeState": true,
      "keyField": "id"
    },
    "inventoryItems": {
      "databaseId": "inventoryItems",
      "mergeState": true,
      "stateField": "ownedCount",
      "keyField": "id"
    },
    "sceneItems": {
      "stateOnly": true
    },
    "keywords": {
      "databaseId": "keywords",
      "mergeState": true,
      "stateField": "collected",
      "keyField": "id"
    },
    "chatgtpKeywordOptions": {
      "databaseId": "keywords",
      "mergeState": true,
      "stateField": "collected",
      "keyField": "id"
    },
    "chatgtpCategories": {
      "databaseId": "diagnosisCategories"
    },
    "mediaState": {
      "stateOnly": true
    },
    "spellState": {
      "stateOnly": true
    },
    "medicalState": {
      "stateOnly": true
    },
    "eventHistory": {
      "stateOnly": true
    }
  },
  "managers": [
    {
      "id": "achievement-manager",
      "activityId": "achievement-manager"
    },
    {
      "id": "inventory-manager",
      "activityId": "inventory-manager"
    },
    {
      "id": "keyword-manager",
      "activityId": "keyword-manager"
    }
  ],
  "saveableVariableExclusions": [
    "calendar:days",
    "event:value",
    "query:records"
  ],
  "saveableVariablePrefixes": [
    "gameState:",
    "__"
  ]
}
