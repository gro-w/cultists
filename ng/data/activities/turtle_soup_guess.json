          }
        }
      },
      "end": {
        "id": "end",
        "type": "activityEnd",
        "inputs": {}
      }
    },
    "connections": [
      {
        "fromNodeId": "start",
        "fromPort": "flowOut",
        "toNodeId": "branch",
        "toPort": "flowIn"
      },
      {
        "fromNodeId": "branch",
        "fromPort": "true",
        "toNodeId": "success",
        "toPort": "flowIn"
      },
      {
        "fromNodeId": "branch",
        "fromPort": "false",
