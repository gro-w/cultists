        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "player",
          "text": "还行，接诊了几个病人……就那样。你呢？",
          "continueKey": "dlg:n2:continue"
        }
      },
      "n3": {
        "id": "n3",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿杰",
          "text": "我也还行。不过我买到了很好吃的酸奶，黏黏的，你要不要来一罐？",
          "continueKey": "dlg:n3:continue"
        }
      },
      "choice4": {
        "id": "choice4",
        "type": "choice",
        "inputs": {
          "options": [
            {
              "label": "好啊，给我一罐吧。"
            },
            {
              "label": "听起来有点恶心……还是算了。"
            }
          ],
          "optionCount": 2,
          "selectionKey": "dlg:choice4:select"
        }
