          {"widgetId":"achievements-tab-unlocked","type":"button","className":"win95-btn bevel-out ach-tab","text":"已解锁","events":{"onClick":{"startNodeId":"start","nodes":{"start":{"id":"start","type":"flowStart","inputs":{},"next":{"flowOut":{"nodeId":"set","port":"flowIn"}}},"set":{"id":"set","type":"setVariable","inputs":{"key":"achievement:filter","value":true},"next":{"flowOut":{"nodeId":"end","port":"flowIn"}}},"end":{"id":"end","type":"activityEnd","inputs":{}}}}}},
          {"widgetId":"achievements-tab-locked","type":"button","className":"win95-btn bevel-out ach-tab","text":"未解锁","events":{"onClick":{"startNodeId":"start","nodes":{"start":{"id":"start","type":"flowStart","inputs":{},"next":{"flowOut":{"nodeId":"set","port":"flowIn"}}},"set":{"id":"set","type":"setVariable","inputs":{"key":"achievement:filter","value":false},"next":{"flowOut":{"nodeId":"end","port":"flowIn"}}},"end":{"id":"end","type":"activityEnd","inputs":{}}}}}}
        ]},
        {"widgetId":"achievements-category","type":"select","className":"win95-input ach-category-select","options":{"nodeId":"categories","port":"value"},"optionValueField":"id","optionLabelField":"label","placeholder":"所有分类","events":{"onChange":{"startNodeId":"start","nodes":{"start":{"id":"start","type":"flowStart","inputs":{},"next":{"flowOut":{"nodeId":"set","port":"flowIn"}}},"set":{"id":"set","type":"setVariable","inputs":{"key":"achievement:category","value":{"variable":"event:value"}},"next":{"flowOut":{"nodeId":"end","port":"flowIn"}}},"end":{"id":"end","type":"activityEnd","inputs":{}}}}}}
