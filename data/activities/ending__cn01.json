        },
        "x": 80,
        "y": 1560
      },
      "n013": {
        "id": "n013",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "binbin",
          "text": "是也不是。",
          "continueKey": "dlg:n013:continue"
        },
        "x": 80,
        "y": 1680
      },
      "n014": {
        "id": "n014",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "player",
          "text": "你是大衮密教的教主吗？",
          "continueKey": "dlg:n014:continue"
