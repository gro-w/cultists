          },
          "game_name": {
            "id": "game_name",
            "type": "text",
            "inputs": {
              "speaker": "阿杰",
              "text": "《皇者荣耀》，你玩过没？"
            },
            "outputs": {},
            "x": 780,
            "y": 360
          },
          "player_guide": {
            "id": "player_guide",
            "type": "text",
            "inputs": {
              "speaker": "player",
