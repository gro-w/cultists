        }
      },
      "n9": {
        "id": "n9",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿杰",
          "text": "其实这也是我的观点。",
          "continueKey": "dlg:n9:continue"
        }
      },
      "n10": {
        "id": "n10",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "player",
          "text": "什么意思？",
