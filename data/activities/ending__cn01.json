        "x": 80,
        "y": 1800
      },
      "n015": {
        "id": "n015",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "binbin",
          "text": "哈哈哈哈哈哈哈哈哈，是。",
