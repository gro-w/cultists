{
  "day": 3,
  "phase": "day",
  "note": "第三天白天：一位患者家属情绪激动地找上门来。",
  "patients": [
    {
      "id": "patient_family_d3",
      "name": "患者家属-陈刚",
      "age": 45,
      "recordTemplateId": "record_headache",
      "keywordIds": ["headache", "angry_family"],
      "dialogueTree": {
        "start": "greet",
        "nodes": {
          "greet": {
            "speaker": "npc",
            "text": "你们医院是干什么吃的！我父亲都[[headache]]这么久了还没人管！",
            "options": [
              { "label": "我们这就为您安排检查，请稍等。", "next": "calm" },
              { "label": "请您先冷静一下，情绪激动对病情没有帮助。", "next": "push_back" },
              {
                "label": "（沟通应对判定）试着用专业而温和的话语先安抚他的情绪。",
                "next": "calm",
                "check": { "skillId": "communication" },
                "outcomes": { "criticalFailure": "push_back" }
              }
            ]
          },
          "calm": {
            "speaker": "npc",
            "text": "……好吧，那就麻烦你们了，动作快一点。",
            "options": [{ "label": "好的，我们尽快安排。", "next": "end_calm" }],
            "onShow": { "npcSanChange": 6 }
          },
          "end_calm": { "speaker": "npc", "text": "谢谢，希望别让我们等太久。", "options": [] },
          "push_back": {
            "speaker": "npc",
            "text": "你什么意思？是说我无理取闹吗！[[angry_family]]",
            "options": [
              { "label": "不是这个意思，我们会尽快处理。", "next": "deescalate" },
              { "label": "您这样大喊大叫，我没法跟您沟通。", "next": "escalate" }
            ],
            "onShow": { "npcSanChange": -10 }
          },
          "deescalate": {
            "speaker": "npc",
            "text": "……算了，你们快点。",
            "options": [{ "label": "好的，马上安排。", "next": "end_calm" }],
            "onShow": { "npcSanChange": 5 }
          },
          "escalate": {
            "speaker": "npc",
            "text": "你还敢跟我犟嘴？！信不信我现在就让你身败名裂！",
            "options": [
              { "label": "（试图缓和气氛）我们都是为了病人好，别激动。", "next": "final_calm" },
              { "label": "（毫不退让）您这样无理取闹，我无法为您提供帮助。", "next": "final_conflict" }
            ],
            "onShow": { "npcSanChange": -20 }
          },
          "final_calm": {
            "speaker": "npc",
            "text": "……哼，算了，你们最好尽快。",
            "options": [{ "label": "好的。", "next": "end_calm" }]
          },
          "final_conflict": {
            "speaker": "npc",
            "text": "（陈刚情绪彻底失控，抄起椅子朝你砸了过来……）",
            "options": [],
            "onShow": { "ending": "mob_violence_death" }
          }
        }
      }
    }
  ],
  "contacts": [
    {
      "id": "roommate_ajun_d3day",
      "name": "阿俊",
      "avatar": "🐶",
      "keywordIds": [],
