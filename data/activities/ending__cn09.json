      "line_015": {
        "id": "line_015",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "player",
          "text": "是啊。Homie你好香，我有嬷欲爽。",
          "continueKey": "dlg:line_015:continue"
        },
        "x": 4540,
        "y": 40
      },
