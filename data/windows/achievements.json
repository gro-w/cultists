      {"widgetId":"achievements-list","type":"list","className":"ach-list panel-inset","items":{"nodeId":"items","port":"value"},"itemLabelTemplate":"{{statusMark}} {{title}}：{{description}}","itemMetaTemplate":"{{unlockDate}}","itemSecretField":"hidden","itemSecretUnlockedField":"unlocked","itemSecretLabel":"？？？？","itemSecretMeta":"探索更多内容以解锁此隐藏成就。","itemIconField":"icon","itemProgressField":"progressPercent","itemProgressOnlyForTriggered":true,"itemClassField":"statusClass","itemClassName":"ach-card"},
