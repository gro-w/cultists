      "line_050": {
        "id": "line_050",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "player",
          "text": "伟大之克苏鲁啊，您还想降下哪些启示吗？我尤其想问的是，为何宇宙的本质充满敌意，物理规律无法满足活人的需求，而盲目痴愚的阿撒托斯只满足于在颤栗黑洞的至高宫廷聆听沉闷的鼓声和单调的风笛？",
          "continueKey": "dlg:line_050:continue"
        }
      },
