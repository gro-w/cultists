        "toPort": "flowIn"
      },
      {
        "fromNodeId": "sealChoice",
        "fromPort": "option0",
        "toNodeId": "sealUse",
        "toPort": "flowIn"
      },
      {
        "fromNodeId": "sealChoice",
        "fromPort": "option1",
        "toNodeId": "end",
        "toPort": "flowIn"
      },
      {
        "fromNodeId": "sealUse",
        "fromPort": "flowOut",
