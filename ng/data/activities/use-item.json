{
  "id": "use-item",
  "displayName": "使用物品",
  "blueprint": {
    "startNodeId": "start",
    "nodes": {
      "start": {"id":"start","type":"flowStart","inputs":{}},
      "payload": {"id":"payload","type":"getVariable","inputs":{"key":"event:payload"}},
      "itemId": {"id":"itemId","type":"getProperty","inputs":{"value":{"nodeId":"payload","port":"value"},"key":"itemId"}},
      "consume": {"id":"consume","type":"callApi","inputs":{"apiId":"runtime.collection.operation","payload":{"collectionId":"inventoryItems","recordId":{"nodeId":"itemId","port":"value"},"operation":"delta","value":-1,"minimum":0},"resultVariable":"item:operation"}},
      "ok": {"id":"ok","type":"getProperty","inputs":{"value":{"variable":"item:operation"},"key":"ok"}},
      "branch": {"id":"branch","type":"branch","inputs":{"condition":{"nodeId":"ok","port":"value"}}},
      "time": {"id":"time","type":"framework:consumeTime","inputs":{"minutes":5}},
      "used": {"id":"used","type":"emitEvent","inputs":{"eventName":"item:used","payload":{"variable":"event:payload"}}},
      "success": {"id":"success","type":"activityEnd","inputs":{}},
      "failure": {"id":"failure","type":"activityEnd","inputs":{}}
    },
    "connections": [
      {"fromNodeId":"start","fromPort":"flowOut","toNodeId":"consume","toPort":"flowIn"},
      {"fromNodeId":"consume","fromPort":"flowOut","toNodeId":"branch","toPort":"flowIn"},
      {"fromNodeId":"branch","fromPort":"true","toNodeId":"time","toPort":"flowIn"},
      {"fromNodeId":"branch","fromPort":"false","toNodeId":"failure","toPort":"flowIn"},
      {"fromNodeId":"time","fromPort":"flowOut","toNodeId":"used","toPort":"flowIn"},
      {"fromNodeId":"used","fromPort":"flowOut","toNodeId":"success","toPort":"flowIn"}
    ]
  }
}
