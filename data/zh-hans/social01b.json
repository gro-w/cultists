        "nodes": {
          "start": { "id": "start", "type": "flowStart", "inputs": {}, "outputs": {}, "x": 40, "y": 360 },
          "invite": { "id": "invite", "type": "text", "inputs": { "speaker": "阿杰", "text": "我正好要做测试手游的视频，要不要来跟我一起玩？" }, "outputs": {}, "x": 260, "y": 360 },
          "ask_game": { "id": "ask_game", "type": "text", "inputs": { "speaker": "player", "text": "什么手游？" }, "outputs": {}, "x": 520, "y": 360 },
          "game_name": { "id": "game_name", "type": "text", "inputs": { "speaker": "阿杰", "text": "《皇者荣耀》，你玩过没？" }, "outputs": {}, "x": 780, "y": 360 },
          "player_guide": { "id": "player_guide", "type": "text", "inputs": { "speaker": "player", "text": "看过攻略，就是推塔游戏呗。应该不难。" }, "outputs": {}, "x": 1040, "y": 360 },
          "start_game": { "id": "start_game", "type": "text", "inputs": { "speaker": "阿杰", "text": "先打。" }, "outputs": {}, "x": 1320, "y": 360 },
          "ask_opponent": { "id": "ask_opponent", "type": "text", "inputs": { "speaker": "player", "text": "要是匹配上很厉害的对手怎么办？" }, "outputs": {}, "x": 1580, "y": 360 },
          "protect": { "id": "protect", "type": "text", "inputs": { "speaker": "阿杰", "text": "有我带你。况且你现在是新手保护期，不会遇到皇者的。" }, "outputs": {}, "x": 1840, "y": 360 },
          "ask_win": { "id": "ask_win", "type": "text", "inputs": { "speaker": "player", "text": "你能保证会赢吗？要不我还是再去看看攻略？" }, "outputs": {}, "x": 2100, "y": 360 },
          "first_choice": { "id": "first_choice", "type": "choice", "inputs": { "branchCount": 2 }, "options": [
