        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "narrator",
          "text": "现在立刻外跑迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯迯",
          "continueKey": "dlg:line_027:continue"
