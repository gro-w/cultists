          "greet": {
            "speaker": "npc",
            "text": "今天门诊是不是出什么事了？走廊里挺吵的。",
            "options": [{ "label": "有个家属情绪比较激动，还好处理过去了。", "next": "end" }]
          },
          "end": { "speaker": "npc", "text": "辛苦了，注意安全。", "options": [] }
        }
      }
    }
