          "give": {
            "speaker": "npc",
            "text": "行吧，那我就给你了，你自己看着办。",
            "options": [
              {
                "label": "好的，我拿去化验看看。",
                "next": "end"
              }
            ],
            "onShow": {
              "grantItems": [
                {
                  "itemId": "mystery_potion",
                  "count": 1
                }
              ]
