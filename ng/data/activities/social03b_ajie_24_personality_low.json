          "displayTo": "dorm-bottom",
          "speaker": "阿杰",
          "text": "要不要帮我测评个游戏？",
          "continueKey": "dlg:n1:continue"
        }
      },
      "n2": {
        "id": "n2",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "player",
          "text": "可以啊，什么游戏？",
          "continueKey": "dlg:n2:continue"
        }
      },
      "n3": {
        "id": "n3",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿杰",
          "text": "《第二十四人格》。",
          "continueKey": "dlg:n3:continue"
        }
      },
      "n4": {
        "id": "n4",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "player",
          "text": "怎么测？",
          "continueKey": "dlg:n4:continue"
        }
      },
      "n5": {
        "id": "n5",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿杰",
          "text": "什么都不要看，直接玩，玩完告诉我感想。",
          "continueKey": "dlg:n5:continue"
        }
      },
      "n6": {
        "id": "n6",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "player",
          "text": "评分都不能看吗……",
          "continueKey": "dlg:n6:continue"
        }
      },
      "n7": {
        "id": "n7",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿杰",
          "text": "不能看。进去抽个卡，“三重馈赠”。 这活动名字听起来像发誓似的。",
          "continueKey": "dlg:n7:continue"
        }
      },
      "choice8": {
        "id": "choice8",
        "type": "choice",
        "inputs": {
          "options": [
            {
              "label": "好吧，那我不看了。"
            },
            {
              "label": "他人的观点是智慧的结晶。"
            }
          ],
          "optionCount": 2,
          "selectionKey": "dlg:choice8:select"
        }
      },
