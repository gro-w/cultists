            },
            "outputs": {},
            "x": 1320,
            "y": 360
          },
          "ask_opponent": {
            "id": "ask_opponent",
            "type": "text",
            "inputs": {
              "speaker": "player",
              "text": "要是匹配上很厉害的对手怎么办？"
            },
            "outputs": {},
            "x": 1580,
            "y": 360
          },
          "protect": {
            "id": "protect",
            "type": "text",
            "inputs": {
              "speaker": "阿杰",
              "text": "有我带你。况且你现在是新手保护期，不会遇到皇者的。"
            },
            "outputs": {},
            "x": 1840,
            "y": 360
          },
          "ask_win": {
            "id": "ask_win",
            "type": "text",
            "inputs": {
              "speaker": "player",
              "text": "你能保证会赢吗？要不我还是再去看看攻略？"
            },
            "outputs": {},
            "x": 2100,
            "y": 360
          },
          "first_choice": {
            "id": "first_choice",
            "type": "choice",
            "inputs": {
              "branchCount": 2
            },
            "options": [
              {
                "label": "那我相信你。",
                "next": "first_favor_plus"
              },
              {
                "label": "要不咱也充点钱。",
                "next": "first_favor_minus"
              }
            ],
            "outputs": {},
            "x": 2380,
            "y": 360
          },
          "trust": {
            "id": "trust",
            "type": "text",
            "inputs": {
              "speaker": "阿杰",
              "text": "这就对了，你先签个到，一会听我指挥。"
            },
            "outputs": {},
            "x": 2660,
            "y": 180
          },
          "trust_nervous": {
            "id": "trust_nervous",
            "type": "text",
            "inputs": {
              "speaker": "player",
