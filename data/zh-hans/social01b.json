          "trust": { "id": "trust", "type": "text", "inputs": { "speaker": "阿杰", "text": "这就对了，你先签个到，一会听我指挥。" }, "outputs": {}, "x": 2660, "y": 180 },
          "trust_nervous": { "id": "trust_nervous", "type": "text", "inputs": { "speaker": "player", "text": "我还是紧张，一定要赢啊。" }, "outputs": {}, "x": 2940, "y": 180 },
          "trust_bless": { "id": "trust_bless", "type": "text", "inputs": { "speaker": "阿杰", "text": "你在向我祷告吗？行，我保佑你赢。" }, "outputs": {}, "x": 3220, "y": 180 },
          "trust_lose": { "id": "trust_lose", "type": "text", "inputs": { "speaker": "player", "text": "输了呢？" }, "outputs": {}, "x": 3500, "y": 180 },
          "trust_drink": { "id": "trust_drink", "type": "text", "inputs": { "speaker": "阿杰", "text": "请你喝8喜。" }, "outputs": {}, "x": 3780, "y": 180 },
          "first_favor_plus": { "id": "first_favor_plus", "type": "setGlobal", "inputs": { "variableId": 40, "delta": 5 }, "outputs": {}, "x": 2660, "y": 360 },
