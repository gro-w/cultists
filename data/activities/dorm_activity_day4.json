          "displayTo": "dorm-bottom",
          "speaker": "阿杰",
          "text": "今天我们来到山中一栋荒废已久的小黑屋里……",
          "continueKey": "dlg:line_0:continue"
        }
      },
      "line_1": {
        "id": "line_1",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿伟",
          "text": "潮湿的雾气，蒸腾的鬼气，月亮照映之下的摇滚之魂在歌唱……",
          "continueKey": "dlg:line_1:continue"
        }
      },
      "line_2": {
        "id": "line_2",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "彬彬",
          "text": "自己人别开腔。",
          "continueKey": "dlg:line_2:continue"
        }
      },
      "line_3": {
        "id": "line_3",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "主控",
          "text": "谁挑的游戏？果然我该去刷题的。",
          "continueKey": "dlg:line_3:continue"
        }
      },
