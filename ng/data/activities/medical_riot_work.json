      "dialogue0": {
        "id": "dialogue0",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者家属",
          "text": "你们把人治成这样还敢说没问题？今天不把责任说清楚谁也别想走！",
          "continueKey": "dlg:dialogue0:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue1": {
        "id": "dialogue1",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者家属",
          "text": "我家人因为你开的药出了大事，你们医院必须马上给个交代！",
          "continueKey": "dlg:dialogue1:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue2": {
        "id": "dialogue2",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者家属",
          "text": "你是不是根本没看清病情就乱开药？出了人命你赔得起吗？",
          "continueKey": "dlg:dialogue2:continue"
        },
        "x": 100,
        "y": 100
      },
      "explain": {
        "id": "explain",
        "type": "choice",
        "inputs": {
          "options": [],
          "optionCount": 1,
          "selectionKey": "dlg:explain:select"
        },
        "x": 100,
        "y": 100
      },
