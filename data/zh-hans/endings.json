      "title": "组一辈子少年乐队！",
      "displayName": "好结局（阿伟线）：组一辈子少年乐队！",
      "icon": "🎸",
      "text": "你和阿伟组了一辈子少年乐队。",
      "priority": 100,
      "blueprint": {
        "startNodeId": "start",
        "nodes": {
          "start": { "id": "start", "type": "flowStart", "inputs": {}, "outputs": {} },
          "__prerequisite__": { "id": "__prerequisite__", "type": "prerequisite", "inputs": { "condition": true }, "outputs": {}, "x": 80, "y": 280 },
          "__schedule_expiry__": { "id": "__schedule_expiry__", "type": "scheduleExpiry", "inputs": { "expires": false, "expiresAt": 0 }, "outputs": {}, "x": 80, "y": 400 },
          "intro_01": { "id": "intro_01", "type": "text", "inputs": { "speaker": "player", "text": "你们的乐队，名字是叫“赞”是吧，似乎要在六道口黑暗学术bar首演了？" } },
          "intro_02": { "id": "intro_02", "type": "text", "inputs": { "speaker": "awei", "text": "对啊，我最近一直在练这个万年氢能旅馆的《永生的岩户城人》。（一阵劲爆的吉他扫弦）" } },
          "intro_03": { "id": "intro_03", "type": "text", "inputs": { "speaker": "player", "text": "岩户城，那不是我老家吗？" } },
          "intro_04": { "id": "intro_04", "type": "text", "inputs": { "speaker": "awei", "text": "傍晚溜点辖办~关掉药厂的易伤" } },
          "intro_05": { "id": "intro_05", "type": "text", "inputs": { "speaker": "player", "text": "咱们在医院实习，何尝不是一种药厂。" } },
          "intro_06": { "id": "intro_06", "type": "text", "inputs": { "speaker": "awei", "text": "棋子在澳洲~我取合剂瓶配酒~" } },
          "intro_07": { "id": "intro_07", "type": "text", "inputs": { "speaker": "player", "text": "还是别喝酒，伤肝。" } },
          "intro_08": { "id": "intro_08", "type": "text", "inputs": { "speaker": "awei", "text": "如此圣火三十年~制导弹杀崩他~" } },
          "intro_09": { "id": "intro_09", "type": "text", "inputs": { "speaker": "player", "text": "大厦是豆腐渣工程吧。" } },
          "intro_10": { "id": "intro_10", "type": "text", "inputs": { "speaker": "awei", "text": "用藏身处的黑案啊~淹没心急的的警官~" } },
          "intro_11": { "id": "intro_11", "type": "text", "inputs": { "speaker": "awei", "text": "核备时打服众~兵帮少年焙香我~" } },
          "intro_12": { "id": "intro_12", "type": "text", "inputs": { "speaker": "player", "text": "师大附中啊，遥远的回忆了。" } },
          "intro_13": { "id": "intro_13", "type": "text", "inputs": { "speaker": "awei", "text": "沉没的诸事~巫法移开的礁石" } },
          "intro_14": { "id": "intro_14", "type": "text", "inputs": { "speaker": "player", "text": "可不是嘛，往家里打电话都限时。电话那儿贴了个“少聊一分，提高一分，提高一分，干掉千人”的横幅。" } },
          "intro_15": { "id": "intro_15", "type": "text", "inputs": { "speaker": "awei", "text": "圣火在惊魇你~制导弹杀崩他~" } },
          "choice": { "id": "choice", "type": "choice", "inputs": { "branchCount": 2, "label0": "喂喂，你有没有听我说话？", "label1": "哎呀真好听，岩户城人可能会被杀死，但摇滚不死。" }, "options": [ { "label": "喂喂，你有没有听我说话？" }, { "label": "哎呀真好听，岩户城人可能会被杀死，但摇滚不死。" } ] },
          "choice_1_01": { "id": "choice_1_01", "type": "text", "inputs": { "speaker": "awei", "text": "你也妹听我唱歌啊！总之要不要来吧，听我们演奏。" } },
          "choice_1_02": { "id": "choice_1_02", "type": "text", "inputs": { "speaker": "player", "text": "正有此意。" } },
          "choice_2_01": { "id": "choice_2_01", "type": "text", "inputs": { "speaker": "awei", "text": "你懂我。" } },
          "choice_2_02": { "id": "choice_2_02", "type": "text", "inputs": { "speaker": "player", "text": "首演的时候，要不要我捧场？" } },
          "choice_2_03": { "id": "choice_2_03", "type": "text", "inputs": { "speaker": "awei", "text": "呵呵，我一定不会让你失望哒！（一阵劲爆的吉他扫弦）" } },
          "concert_cg": { "id": "concert_cg", "type": "showCg", "inputs": { "cgId": "cg_awei_band_ending" } },
          "concert_01": { "id": "concert_01", "type": "text", "inputs": { "speaker": "awei", "text": "亿万匹拓疆的蛙~在祂滔海中奔跑~（一阵劲爆的吉他尾杀）" } },
          "concert_02": { "id": "concert_02", "type": "text", "inputs": { "speaker": "narrator", "text": "喔喔喔喔喔喔！咿呀！咿呀！" } },
          "concert_03": { "id": "concert_03", "type": "text", "inputs": { "speaker": "player", "text": "咿呀！" } },
          "concert_04": { "id": "concert_04", "type": "text", "inputs": { "speaker": "awei", "text": "谢谢！" } },
          "concert_05": { "id": "concert_05", "type": "text", "inputs": { "speaker": "awei", "text": "这次我要特别感谢我的一位朋友。" } },
          "concert_06": { "id": "concert_06", "type": "text", "inputs": { "speaker": "narrator", "text": "那一人是谁？" } },
          "concert_07": { "id": "concert_07", "type": "text", "inputs": { "speaker": "awei", "text": "这位朋友，在我最穷困的时候不忘鼓励我哀兵必胜，在我最辉煌的时刻也不忘提醒我骄兵必败！" } },
          "concert_08": { "id": "concert_08", "type": "text", "inputs": { "speaker": "awei", "text": "没有这位朋友支持我努力走下去，就没有我今日的监听级发烧耳机，也没有我们即将在流媒体上架的歌曲的HiFi音质。" } },
          "concert_09": { "id": "concert_09", "type": "text", "inputs": { "speaker": "awei", "text": "好Homie，你在我心中的地位，堪比让赛博坦陆逊反败为胜的夷陵山脉最后一道山梁，在演唱结束时，让我们为这个残酷世界里的最后一道善良，点“赞”！我们要组一辈子少年乐队！谢谢。" } },
          "concert_end": { "id": "concert_end", "type": "endCg", "inputs": {} },
          "after_01": { "id": "after_01", "type": "text", "inputs": { "speaker": "player", "text": "唱得不错，还有……特别感谢，你的特别感谢。" } },
          "after_02": { "id": "after_02", "type": "text", "inputs": { "speaker": "player", "text": "我很久没被人这样夸过了。" } },
          "after_03": { "id": "after_03", "type": "text", "inputs": { "speaker": "awei", "text": "无所谓，我会出手。" } },
          "after_04": { "id": "after_04", "type": "text", "inputs": { "speaker": "awei", "text": "往后余生，就由我一人，夸你，“赞”你，稳稳地接住你。", "onShow": { "ending": "组一辈子少年乐队！" } } },
          "end": { "id": "end", "type": "scheduleEnd", "inputs": {}, "outputs": {} }
        },
