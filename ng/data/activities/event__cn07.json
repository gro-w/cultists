        }
      },
      "line_063": {
        "id": "line_063",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "克苏鲁",
          "text": "你能用绳索穿它的鼻子吗？能用钩穿它的腮骨吗？",
          "continueKey": "dlg:line_063:continue"
        }
      },
      "line_064": {
        "id": "line_064",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "克苏鲁",
          "text": "它岂向你连连恳求，说柔和的话吗？",
          "continueKey": "dlg:line_064:continue"
        }
      },
      "line_065": {
        "id": "line_065",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "克苏鲁",
          "text": "岂肯与你立约，使你拿它永远作奴仆吗？",
          "continueKey": "dlg:line_065:continue"
