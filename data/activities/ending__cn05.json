        "y": 40
      },
      "n004": {
        "id": "n004",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "ajie",
          "text": "不，快放下它！你发神经吗？",
          "continueKey": "dlg:n004:continue"
