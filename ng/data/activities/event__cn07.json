      },
      "line_060": {
        "id": "line_060",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "克苏鲁",
          "text": "你能向云彩扬起声来，使倾盆的雨遮盖你吗？",
          "continueKey": "dlg:line_060:continue"
        }
      },
      "line_061": {
        "id": "line_061",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "克苏鲁",
          "text": "你能发出闪电，叫它行去，使它对你说，我们在这里。",
