        "x": 2440,
        "y": 40
      },
      "line_009": {
        "id": "line_009",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "binbin",
          "text": "嗯嗯，猩红果实为引，动物尸片为祭，确实好吃。",
