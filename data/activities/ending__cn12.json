        "x": 9940,
        "y": 40
      },
      "after_04": {
        "id": "after_04",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "awei",
          "text": "往后余生，就由我一人，夸你，“赞”你，稳稳地接住你。",
