{
  "id": "inventory-manager",
  "displayName": "物品管理器",
  "type": "manager",
  "blueprint": {
    "startNodeId": "start",
    "nodes": {
      "start": {
        "id": "start",
        "type": "flowStart",
        "inputs": {}
      },
      "ready": {
        "id": "ready",
        "type": "emitEvent",
        "inputs": {
          "eventName": "inventory:manager-ready",
          "payload": {
            "source": "inventory-manager"
          }
        }
      },
      "end": {
        "id": "end",
        "type": "activityEnd",
        "inputs": {}
      }
    },
    "connections": [
      {
        "id": "edge-1",
        "fromNodeId": "start",
        "fromPort": "flowOut",
        "toNodeId": "ready",
        "toPort": "flowIn"
      },
      {
        "id": "edge-2",
        "fromNodeId": "ready",
        "fromPort": "flowOut",
        "toNodeId": "end",
        "toPort": "flowIn"
      }
    ]
  }
}
