          "pay_church": { "id": "pay_church", "type": "text", "inputs": { "speaker": "阿杰", "text": "所有人都这么想，充点钱就容易了，段位高了，心愿达成了——这么说手游跟教堂有什么区别？都是门口放个箱子收钱。" }, "outputs": {}, "x": 3220, "y": 540 },
          "death": { "id": "death", "type": "text", "inputs": { "speaker": "player", "text": "我好像快死了，怎么办？" }, "outputs": {}, "x": 4060, "y": 360 },
          "second_personality": { "id": "second_personality", "type": "text", "inputs": { "speaker": "阿杰", "text": "没事，死了又不是终点。有些时候，死了还能激发出英雄的第二人格——就像我们一样，有时候得“死”一次才能活出真我。" }, "outputs": {}, "x": 4340, "y": 360 },
          "revive": { "id": "revive", "type": "text", "inputs": { "speaker": "player", "text": "我又复活了。" }, "outputs": {}, "x": 4620, "y": 360 },
          "push_tower": { "id": "push_tower", "type": "text", "inputs": { "speaker": "阿杰", "text": "快去推塔，我们快赢了。" }, "outputs": {}, "x": 4900, "y": 360 },
          "second_choice": { "id": "second_choice", "type": "choice", "inputs": { "branchCount": 2 }, "options": [
            { "label": "呼，没想到这么快就结束了，好刺激。", "next": "second_favor_plus" },
            { "label": "要是有攻略刚才我肯定不会死。死掉的感觉太糟糕了，哪怕是在游戏里。", "next": "second_favor_minus" }
          ], "outputs": {}, "x": 5180, "y": 360 },
          "excited_reply": { "id": "excited_reply", "type": "text", "inputs": { "speaker": "阿杰", "text": "怎么样，攻略可带不来这种感觉。" }, "outputs": {}, "x": 5460, "y": 180 },
          "excited_endline": { "id": "excited_endline", "type": "text", "inputs": { "speaker": "player", "text": "……确实。" }, "outputs": {}, "x": 5740, "y": 180 },
          "regret_reply": { "id": "regret_reply", "type": "text", "inputs": { "speaker": "阿杰", "text": "没办法，有人当主力，有人就得当炮灰。刚才对面那个辅助，为保射手死了那么多次，遇上我还是得输。" }, "outputs": {}, "x": 5460, "y": 540 },
          "regret_endline": { "id": "regret_endline", "type": "text", "inputs": { "speaker": "player", "text": "……确实。" }, "outputs": {}, "x": 5740, "y": 540 },
          "second_favor_plus": { "id": "second_favor_plus", "type": "setGlobal", "inputs": { "variableId": 40, "delta": 5 }, "outputs": {}, "x": 5460, "y": 360 },
