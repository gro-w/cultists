{
  "id": "medical_complaint_work",
  "type": "medicalIncident",
  "displayName": "medical_complaint_work",
  "queueId": "work",
  "blueprint": {
    "startNodeId": "start",
    "nodes": {
      "start": {
        "id": "start",
        "type": "flowStart",
        "inputs": {},
        "x": 100,
        "y": 100
      },
      "random": {
        "id": "random",
        "type": "framework:randomBranch",
        "inputs": {
          "n": 20
        },
        "x": 100,
        "y": 100
      },
      "dialogue0": {
        "id": "dialogue0",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "医生，药吃了好几天，症状一点都没减轻，你们到底有没有认真看病？",
          "continueKey": "dlg:dialogue0:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue1": {
        "id": "dialogue1",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "我照着处方按时吃药，病情却越来越严重，这让我怎么相信你们？",
          "continueKey": "dlg:dialogue1:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue2": {
        "id": "dialogue2",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "这药不仅没效果，还让我整晚睡不着，你们必须给我一个解释。",
          "continueKey": "dlg:dialogue2:continue"
        },
        "x": 100,
        "y": 100
      },
      "explain": {
        "id": "explain",
        "type": "choice",
        "inputs": {
          "options": [],
          "optionCount": 1,
          "selectionKey": "dlg:explain:select"
        },
        "x": 100,
        "y": 100
      },
      "skill": {
        "id": "skill",
        "type": "getPublicVariable",
        "inputs": {
          "id": 22
        },
        "x": 100,
        "y": 100
      },
      "check": {
        "id": "check",
        "type": "framework:diceCheck",
        "inputs": {
          "n": 0
        },
        "x": 100,
        "y": 100
      },
      "persuaded": {
        "id": "persuaded",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "系统",
          "text": "你成功说服了对方，对方暂时平静下来并离开了。",
          "continueKey": "dlg:persuaded:continue"
        },
        "x": 100,
        "y": 100
      },
      "fine": {
        "id": "fine",
        "type": "applyPublicVariableEffect",
        "inputs": {
          "delta": -100,
          "id": 2
        },
        "x": 100,
        "y": 100
      },
      "doubleFine": {
        "id": "doubleFine",
        "type": "applyPublicVariableEffect",
        "inputs": {
          "delta": -200,
          "id": 2
        },
        "x": 100,
        "y": 100
      },
      "end": {
        "id": "end",
        "type": "activityEnd",
        "inputs": {},
        "x": 100,
        "y": 100
      },
      "__prerequisite__": {
        "id": "__prerequisite__",
        "type": "prerequisite",
        "inputs": {
          "condition": true
        },
        "x": 100,
        "y": 100
      },
      "__activity_expiry__": {
        "id": "__activity_expiry__",
        "type": "activityExpiry",
        "inputs": {
          "expires": false,
          "expiresAt": 0
        },
        "x": 100,
        "y": 100
      },
      "fineText": {
        "id": "fineText",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "系统",
          "text": "你未能平息对方的愤怒，你被罚款了100元。",
          "continueKey": "dlg:fineText:continue"
        },
        "x": 100,
        "y": 100
      },
      "doubleFineText": {
        "id": "doubleFineText",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "系统",
          "text": "你的辩解反而激起了对方的怒火，你被罚款了200元。",
          "continueKey": "dlg:doubleFineText:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue3": {
        "id": "dialogue3",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "复诊的时候你说很快会好，现在一点起色都没有，是不是误诊了？",
          "continueKey": "dlg:dialogue3:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue4": {
        "id": "dialogue4",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "我们花钱来治病，不是来试药的，这个治疗结果太让人失望了。",
          "continueKey": "dlg:dialogue4:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue5": {
        "id": "dialogue5",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "药盒上的说明和你说的不一样，我吃出不舒服谁来负责？",
          "continueKey": "dlg:dialogue5:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue6": {
        "id": "dialogue6",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "我已经跑了三趟医院，问题还是没有解决，你们的医生能不能上点心？",
          "continueKey": "dlg:dialogue6:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue7": {
        "id": "dialogue7",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "你开的药让我胃疼得更厉害了，之前为什么不把风险说清楚？",
          "continueKey": "dlg:dialogue7:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue8": {
        "id": "dialogue8",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "病人一直在受罪，你们却只会让我们继续等，今天必须说明白。",
          "continueKey": "dlg:dialogue8:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue9": {
        "id": "dialogue9",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "检查结果出来这么久了还没人解释，这种服务也太不负责任了。",
          "continueKey": "dlg:dialogue9:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue10": {
        "id": "dialogue10",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "我按你说的换了药，反而出现了新的症状，你们是不是把人当实验品？",
          "continueKey": "dlg:dialogue10:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue11": {
        "id": "dialogue11",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "同样的病别人都能治好，为什么到了你这里就一直拖着？",
          "continueKey": "dlg:dialogue11:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue12": {
        "id": "dialogue12",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "你们承诺的治疗效果完全没有出现，这笔钱是不是该退给我们？",
          "continueKey": "dlg:dialogue12:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue13": {
        "id": "dialogue13",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "我问了好几次注意事项都没人说，现在出了问题就想装作不知道？",
          "continueKey": "dlg:dialogue13:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue14": {
        "id": "dialogue14",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "病情明明在恶化，你还说这是正常反应，我不能接受这个说法。",
          "continueKey": "dlg:dialogue14:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue15": {
        "id": "dialogue15",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "今天不给出明确的处理办法，我就要向医院和有关部门投诉。",
          "continueKey": "dlg:dialogue15:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue16": {
        "id": "dialogue16",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "处方上的剂量是不是写错了？病人吃完之后整个人都不对劲。",
          "continueKey": "dlg:dialogue16:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue17": {
        "id": "dialogue17",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "我们相信你的专业判断才接受治疗，现在结果这样，你必须承担责任。",
          "continueKey": "dlg:dialogue17:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue18": {
        "id": "dialogue18",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "这次看病既浪费时间又花了冤枉钱，你们至少应该认真道歉。",
          "continueKey": "dlg:dialogue18:continue"
        },
        "x": 100,
        "y": 100
      },
      "dialogue19": {
        "id": "dialogue19",
        "type": "text",
        "inputs": {
          "displayTo": "his-app",
          "speaker": "患者",
          "text": "我只想知道病什么时候能好，你们不能每次都用几句话把我打发走。",
          "continueKey": "dlg:dialogue19:continue"
        },
        "x": 100,
        "y": 100
      }
