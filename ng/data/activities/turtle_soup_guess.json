            "port": "value"
          },
          "right": "他曾经误食了亲人的肉"
        }
      },
      "match2": {
        "id": "match2",
        "type": "arithmetic",
        "inputs": {
          "operator": "=",
          "left": {
            "nodeId": "guess",
            "port": "value"
          },
          "right": "海难获救后喝到的是亲人肉，后来发现真相"
        }
      },
      "matches": {
        "id": "matches",
        "type": "arithmetic",
        "inputs": {
          "operator": "or",
          "left": {
