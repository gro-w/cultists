{
  "id": "achievements",
  "title": "成就",
  "icon": "🏆",
  "width": 440,
  "height": 480,
  "resizable": true,
  "singleInstance": true,
  "valueGraph": {
    "nodes": {
      "records": {
        "id": "records",
        "type": "findRecordsValue",
        "inputs": {
          "databaseId": "achievements",
          "query": {}
        }
      },
      "states": {
        "id": "states",
        "type": "getRuntimeCollection",
        "inputs": {
          "collectionId": "achievementStates"
        }
      },
      "categories": {
        "id": "categories",
        "type": "getRuntimeCollection",
        "inputs": {
          "collectionId": "achievementCategories"
        }
      },
      "items": {
        "id": "items",
        "type": "getRuntimeCollection",
        "inputs": {
          "collectionId": "achievementItems"
        }
      }
    }
  },
  "root": {
    "widgetId": "achievements-root",
    "className": "app-achievements",
    "type": "container",
    "flow": "vertical",
    "gap": 8,
    "padding": 10,
    "children": [
      {
        "widgetId": "achievements-toolbar",
        "type": "container",
        "className": "ach-toolbar",
        "flow": "vertical",
        "gap": 4,
        "children": [
          {
            "widgetId": "achievements-tabs",
            "type": "container",
            "className": "ach-tabs",
            "flow": "horizontal",
            "gap": 0,
            "children": [
              {
                "widgetId": "achievements-tab-all",
                "type": "button",
                "className": "win95-btn bevel-out ach-tab active",
                "text": "全部",
                "events": {
                  "onClick": {
                    "cl2": "/** CL2 export for activity data/windows/achievements.json.root.children[0].children[0].children[0].events.onClick Generated from canonical blueprint JSON. */ start: flowStart(); set: setVariable(\"achievement:filter\", \"all\"); end: end();"
                  }
                }
              },
              {
                "widgetId": "achievements-tab-unlocked",
                "type": "button",
                "className": "win95-btn bevel-out ach-tab",
                "text": "已解锁",
                "events": {
                  "onClick": {
                    "cl2": "/** CL2 export for activity data/windows/achievements.json.root.children[0].children[0].children[1].events.onClick Generated from canonical blueprint JSON. */ start: flowStart(); set: setVariable(\"achievement:filter\", true); end: end();"
                  }
                }
              },
              {
                "widgetId": "achievements-tab-locked",
                "type": "button",
                "className": "win95-btn bevel-out ach-tab",
                "text": "未解锁",
                "events": {
                  "onClick": {
                    "cl2": "/** CL2 export for activity data/windows/achievements.json.root.children[0].children[0].children[2].events.onClick Generated from canonical blueprint JSON. */ start: flowStart(); set: setVariable(\"achievement:filter\", false); end: end();"
                  }
                }
              }
            ]
          },
          {
            "widgetId": "achievements-category",
            "type": "select",
            "className": "win95-input ach-category-select",
            "options": {
              "nodeId": "categories",
              "port": "value"
            },
            "optionValueField": "id",
            "optionLabelField": "label",
            "placeholder": "所有分类",
            "events": {
              "onChange": {
                "cl2": "/** CL2 export for activity data/windows/achievements.json.root.children[0].children[1].events.onChange Generated from canonical blueprint JSON. */ start: flowStart(); set: setVariable(\"achievement:category\", {\"variable\":\"event:value\"}); end: end();"
              }
            }
          }
        ]
      },
      {
        "widgetId": "achievements-summary",
        "type": "label",
        "className": "ach-summary panel-inset",
        "text": "成就进度"
      },
      {
        "widgetId": "achievements-list",
        "type": "list",
        "className": "ach-list panel-inset",
        "items": {
          "nodeId": "items",
          "port": "value"
        },
        "itemLabelTemplate": "{{statusMark}} {{title}}：{{description}}",
        "itemMetaTemplate": "{{unlockDate}}",
        "itemSecretField": "hidden",
        "itemSecretUnlockedField": "unlocked",
        "itemSecretLabel": "？？？？",
        "itemSecretMeta": "探索更多内容以解锁此隐藏成就。",
        "itemIconField": "icon",
        "itemProgressField": "progressPercent",
        "itemProgressOnlyForTriggered": true,
        "itemClassField": "statusClass",
        "itemClassName": "ach-card"
      },
      {
        "widgetId": "achievements-note",
        "type": "label",
        "className": "status-note",
        "text": "未解锁的成就会在达成条件后记录"
      }
    ]
  },
  "events": {
    "onCreate": {
      "cl2": "/** CL2 export for activity data/windows/achievements.json.events.onCreate Generated from canonical blueprint JSON. */ start: flowStart(); filter: setVariable(\"achievement:filter\", \"all\"); category: setVariable(\"achievement:category\", \"\"); end: end();"
    }
  }
}
