        "y": 1320
      },
      "n011": {
        "id": "n011",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "binbin",
          "text": "违规警告一次。你只能问能用是或否回答的问题。下次，可就不只是警告了。",
          "continueKey": "dlg:n011:continue"
        },
        "x": 80,
        "y": 1440
      },
      "n012": {
        "id": "n012",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "player",
          "text": "你是大衮密教的教徒吗？",
