      "n1": {
        "id": "n1",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿伟",
          "text": "我需要你帮我下决心……",
          "continueKey": "dlg:n1:continue"
        }
      },
      "n2": {
        "id": "n2",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿伟",
          "text": "我买了个新耳机，你知道我，这个耳机我喜欢很久了。正好这次打折，我咬咬牙就买了，千金难买心头好。",
          "continueKey": "dlg:n2:continue"
        }
      },
      "n3": {
        "id": "n3",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿伟",
          "text": "后天就要到尾款期限了。",
          "continueKey": "dlg:n3:continue"
        }
      },
      "n4": {
        "id": "n4",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "player",
          "text": "你想留它吗？",
          "continueKey": "dlg:n4:continue"
        }
      },
      "n5": {
        "id": "n5",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿伟",
          "text": "有些事情是由不得我的。全都由不得我。想让事情按我想的那样发展只是一种幻觉罢了。",
          "continueKey": "dlg:n5:continue"
        }
      },
      "n6": {
        "id": "n6",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "player",
          "text": "还差多少钱？",
          "continueKey": "dlg:n6:continue"
        }
      },
      "n7": {
        "id": "n7",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿伟",
          "text": "还差五千。",
          "continueKey": "dlg:n7:continue"
        }
      },
      "n8": {
        "id": "n8",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "player",
          "text": "这么多？我只有一千八，可以借给你。",
          "continueKey": "dlg:n8:continue"
        }
      },
      "n9": {
        "id": "n9",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿伟",
          "text": "虽然还是不够……不过谢谢你。",
          "continueKey": "dlg:n9:continue"
        }
      },
      "choice10": {
        "id": "choice10",
        "type": "choice",
        "inputs": {
          "options": [
            {
              "label": "你可以再去问问别人。"
            },
            {
              "label": "你不会不还吧，为了听《月之暗面》你烧了不少钱了。"
            }
          ],
          "optionCount": 2,
          "selectionKey": "dlg:choice10:select"
        }
      },
