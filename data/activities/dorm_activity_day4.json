      "line_4": {
        "id": "line_4",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿杰",
          "text": "怎么会呢，你该天天都加入我们相亲相爱的宿舍集体活动。",
          "continueKey": "dlg:line_4:continue"
        }
      },
      "line_5": {
        "id": "line_5",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿伟",
          "text": "有人会玩吗？有人会我就不看攻略了",
          "continueKey": "dlg:line_5:continue"
        }
      },
      "line_6": {
