      },
      "n2": {
        "id": "n2",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "player",
          "text": "这是你新买的？看起来很贵啊，你不才买了个黑椒唱片机吗？"
        },
        "outputs": {}
      },
      "n3": {
        "id": "n3",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿伟",
          "text": "是啊，不错吧，在购物车里放了好久终于等到降价了。"
        },
        "outputs": {}
      },
      "n4": {
        "id": "n4",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "player",
          "text": "你全款买的？"
        },
        "outputs": {}
      },
      "n5": {
        "id": "n5",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿伟",
          "text": "……还没付尾款。到底听不听？赶紧的。"
        },
        "outputs": {}
      },
      "n6": {
        "id": "n6",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "player",
          "text": "音质很……好，声场比较强，有空间感，高音甜中音稳低音沉……"
        },
        "outputs": {}
      },
      "n7": {
        "id": "n7",
        "type": "text",
        "inputs": {
          "displayTo": "dorm-bottom",
          "speaker": "阿伟",
          "text": "你有没有听到什么奇怪的声音？"
        },
        "outputs": {}
      },
      "n8": {
        "id": "n8",
