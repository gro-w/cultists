            "inputs": {
              "displayTo": "his-app",
              "speaker": "系统",
              "text": "你成功说服了对方，对方暂时平静下来并离开了。"
            },
            "outputs": {},
            "x": 100,
            "y": 100
          },
          "fine": {
            "id": "fine",
            "type": "setGlobal",
            "inputs": {
              "variableId": 2,
