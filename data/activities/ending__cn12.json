      "intro_01": {
        "id": "intro_01",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "player",
          "text": "你们的乐队，名字是叫“赞”是吧，似乎要在六道口黑暗学术bar首演了？",
          "continueKey": "dlg:intro_01:continue"
        },
        "x": 340,
        "y": 40
      },
      "intro_02": {
        "id": "intro_02",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "awei",
          "text": "对啊，我最近一直在练这个万年氢能旅馆的《永生的岩户城人》。（一阵劲爆的吉他扫弦）",
          "continueKey": "dlg:intro_02:continue"
        },
        "x": 640,
        "y": 40
      },
      "intro_03": {
        "id": "intro_03",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "player",
          "text": "岩户城，那不是我老家吗？",
          "continueKey": "dlg:intro_03:continue"
        },
        "x": 940,
        "y": 40
      },
      "intro_04": {
        "id": "intro_04",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "awei",
          "text": "傍晚溜点辖办~关掉药厂的易伤",
          "continueKey": "dlg:intro_04:continue"
        },
        "x": 1240,
        "y": 40
      },
      "intro_05": {
        "id": "intro_05",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "player",
          "text": "咱们在医院实习，何尝不是一种药厂。",
          "continueKey": "dlg:intro_05:continue"
        },
        "x": 1540,
        "y": 40
      },
      "intro_06": {
        "id": "intro_06",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "awei",
          "text": "棋子在澳洲~我取合剂瓶配酒~",
          "continueKey": "dlg:intro_06:continue"
        },
        "x": 1840,
        "y": 40
      },
      "intro_07": {
        "id": "intro_07",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "player",
          "text": "还是别喝酒，伤肝。",
          "continueKey": "dlg:intro_07:continue"
        },
        "x": 2140,
        "y": 40
      },
      "intro_08": {
        "id": "intro_08",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "awei",
          "text": "如此圣火三十年~制导弹杀崩他~",
          "continueKey": "dlg:intro_08:continue"
        },
        "x": 2440,
        "y": 40
      },
      "intro_09": {
        "id": "intro_09",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "player",
          "text": "大厦是豆腐渣工程吧。",
          "continueKey": "dlg:intro_09:continue"
        },
        "x": 2740,
        "y": 40
      },
      "intro_10": {
        "id": "intro_10",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "awei",
          "text": "用藏身处的黑案啊~淹没心急的的警官~",
          "continueKey": "dlg:intro_10:continue"
        },
        "x": 3040,
        "y": 40
      },
      "intro_11": {
        "id": "intro_11",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "awei",
          "text": "核备时打服众~兵帮少年焙香我~",
          "continueKey": "dlg:intro_11:continue"
        },
        "x": 3340,
        "y": 40
      },
      "intro_12": {
        "id": "intro_12",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "player",
          "text": "师大附中啊，遥远的回忆了。",
          "continueKey": "dlg:intro_12:continue"
        },
        "x": 3640,
        "y": 40
      },
      "intro_13": {
        "id": "intro_13",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "awei",
          "text": "沉没的诸事~巫法移开的礁石",
          "continueKey": "dlg:intro_13:continue"
        },
        "x": 3940,
        "y": 40
      },
      "intro_14": {
        "id": "intro_14",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "player",
          "text": "可不是嘛，往家里打电话都限时。电话那儿贴了个“少聊一分，提高一分，提高一分，干掉千人”的横幅。",
          "continueKey": "dlg:intro_14:continue"
        },
        "x": 4240,
        "y": 40
      },
      "intro_15": {
        "id": "intro_15",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "awei",
          "text": "圣火在惊魇你~制导弹杀崩他~",
          "continueKey": "dlg:intro_15:continue"
        },
        "x": 4540,
        "y": 40
      },
      "choice": {
        "id": "choice",
        "type": "choice",
        "inputs": {
          "options": [],
          "optionCount": 2,
          "selectionKey": "dlg:choice:select"
        },
        "x": 4840,
        "y": 40
      },
      "choice_1_01": {
        "id": "choice_1_01",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "awei",
          "text": "你也妹听我唱歌啊！总之要不要来吧，听我们演奏。",
          "continueKey": "dlg:choice_1_01:continue"
        },
        "x": 5140,
        "y": 205
      },
      "choice_1_02": {
        "id": "choice_1_02",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "player",
          "text": "正有此意。",
          "continueKey": "dlg:choice_1_02:continue"
        },
        "x": 5440,
        "y": 205
      },
      "choice_2_01": {
        "id": "choice_2_01",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "awei",
          "text": "你懂我。",
          "continueKey": "dlg:choice_2_01:continue"
        },
        "x": 5140,
        "y": 40
      },
      "choice_2_02": {
        "id": "choice_2_02",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "player",
          "text": "首演的时候，要不要我捧场？",
          "continueKey": "dlg:choice_2_02:continue"
        },
        "x": 5440,
        "y": 40
      },
      "choice_2_03": {
        "id": "choice_2_03",
        "type": "text",
        "inputs": {
          "displayTo": "ending-screen",
          "speaker": "awei",
          "text": "呵呵，我一定不会让你失望哒！（一阵劲爆的吉他扫弦）",
          "continueKey": "dlg:choice_2_03:continue"
        },
        "x": 5740,
        "y": 40
      },
